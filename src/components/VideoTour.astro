---
// The feature video (drawn on a canvas from demo screenshots, with a spoken voiceover; see
// scripts/video/). No autoplay; nothing loads until the visitor presses play.
import video from '../data/video.json';

const { files } = video;
---

<div class="tour">
  <video controls preload="none" playsinline poster={files.poster} width="1920" height="1080" aria-label="Feature video: Medical Before After Gallery Pro">
    <source src={files.mp4} type="video/mp4" />
    <source src={files.webm} type="video/webm" />
    <track kind="captions" src={files.captions} srclang="en" label="English" />
    <p>
      Your browser can’t play this video. <a href={files.mp4}>Download it (MP4)</a>.
    </p>
  </video>
</div>

<style>
  .tour {
    max-width: 1040px;
    margin-inline: auto;
  }
  .tour video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    background: var(--bg-dark);
    box-shadow: var(--shadow-lg);
  }
</style>
