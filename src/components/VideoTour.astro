---
// The feature video (drawn on a canvas from demo screenshots and recorded in Chrome; see
// scripts/video/). No autoplay; nothing loads until the visitor presses play.
import video from '../data/video.json';

const { files, scenes, fade } = video;
const list = scenes.map((s) => s.list);
const seconds = Math.round(scenes.reduce((sum, s) => sum + s.seconds, 0) - fade * (scenes.length - 1));
const length = `${Math.floor(seconds / 60)} min ${seconds % 60} s`;
---

<div class="tour">
  <div class="tour-player">
    <video controls preload="none" playsinline poster={files.poster} width="1920" height="1080" aria-describedby="tour-list">
      <source src={files.mp4} type="video/mp4" />
      <source src={files.webm} type="video/webm" />
      <p>
        Your browser can’t play this video. <a href={files.mp4}>Download it (MP4)</a>.
      </p>
    </video>
  </div>
  <div class="tour-copy">
    <h3>What the video shows</h3>
    <p class="tour-note">{length}, no sound. Every scene is a screenshot of the live demo site.</p>
    <ol id="tour-list" class="tour-list">
      {list.map((item) => <li>{item}</li>)}
    </ol>
  </div>
</div>

<style>
  .tour {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .tour-player video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    background: var(--bg-dark);
    box-shadow: var(--shadow-lg);
  }
  .tour-copy h3 {
    font-size: 1.2rem;
  }
  .tour-note {
    color: var(--text-light);
    font-size: 0.92rem;
    margin-top: 0.35rem;
  }
  .tour-list {
    list-style: decimal;
    padding-left: 1.4rem;
    margin-top: 1rem;
    columns: 2;
    column-gap: 2rem;
    font-size: 0.92rem;
    color: var(--text);
  }
  .tour-list li {
    break-inside: avoid;
    padding: 0.15rem 0;
  }
  .tour-list li::marker {
    color: var(--text-light);
    font-weight: 600;
  }
  @media (max-width: 980px) {
    .tour {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .tour-list {
      columns: 1;
    }
  }
</style>
