---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/format';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const { title, description, date, author, category, image, imageAlt } = post.data;
const href = `/blog/${post.id}/`;
---

<article class:list={['blog-card card', { featured }]}>
  <a href={href} class="thumb" aria-hidden="true" tabindex="-1">
    {image && <img src={image} alt={imageAlt ?? ''} loading="lazy" />}
    {category && <span class="cat">{category}</span>}
  </a>
  <div class="body">
    <div class="meta">
      <span><i class="fa-regular fa-calendar" aria-hidden="true"></i> {formatDate(date)}</span>
      <span><i class="fa-regular fa-user" aria-hidden="true"></i> {author}</span>
    </div>
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <a href={href} class="read-more">Read article <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .blog-card.featured {
    border-color: var(--primary);
  }
  .thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-softer);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .blog-card:hover .thumb img {
    transform: scale(1.05);
  }
  .cat {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    background: rgba(15, 27, 51, 0.7);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    backdrop-filter: blur(6px);
  }
  .featured .cat {
    background: var(--gradient-primary);
  }
  .body {
    padding: 1.4rem 1.4rem 1.6rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--text-lighter);
    font-size: 0.8rem;
    margin-bottom: 0.7rem;
  }
  .meta i {
    color: var(--primary);
    margin-right: 0.25rem;
  }
  .body h3 {
    font-size: 1.15rem;
    line-height: 1.35;
    margin-bottom: 0.55rem;
  }
  .body h3 a {
    color: var(--ink);
  }
  .body h3 a:hover {
    color: var(--primary-dark);
  }
  .body p {
    color: var(--text-light);
    font-size: 0.93rem;
    flex: 1;
  }
  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.1rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--primary-dark);
    transition: gap 0.18s ease;
  }
  .read-more:hover {
    gap: 0.75rem;
  }
</style>
