---
import { footerNav } from '../data/nav';
import { site } from '../data/site';

const year = new Date().getFullYear();
const socials = [
  { icon: 'fa-brands fa-facebook-f', href: site.social.facebook, label: 'Facebook' },
  { icon: 'fa-brands fa-x-twitter', href: site.social.twitter, label: 'X' },
  { icon: 'fa-brands fa-instagram', href: site.social.instagram, label: 'Instagram' },
  { icon: 'fa-brands fa-linkedin-in', href: site.social.linkedin, label: 'LinkedIn' },
].filter((s) => s.href);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="brand">
        <span class="brand-mark" aria-hidden="true"><i class="fa-solid fa-clone"></i></span>
        <span class="brand-name">MBA<span>Gallery</span></span>
      </a>
      <p>The before &amp; after image gallery plugin built for medical and aesthetic practices.</p>
      <a href="/contact/" class="footer-email">
        <i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Contact us
      </a>
      {
        socials.length > 0 && (
          <div class="socials">
            {socials.map((s) => (
              <a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer">
                <i class={s.icon} aria-hidden="true" />
              </a>
            ))}
          </div>
        )
      }
    </div>

    {
      footerNav.map((col) => (
        <nav class="footer-col" aria-label={col.heading}>
          <h3>{col.heading}</h3>
          <ul>
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} {site.legalName}. All rights reserved.</p>
    <p class="footer-note">
      Not affiliated with WordPress&reg;. WordPress is a trademark of the WordPress Foundation.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-dark);
    color: #aebbd2;
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 2.5rem;
    padding-bottom: 2.5rem;
  }
  .footer-brand .brand {
    color: #fff;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--gradient-primary);
    color: #fff;
  }
  .brand-name {
    font-size: 1.25rem;
    color: #fff;
    letter-spacing: -0.03em;
  }
  .brand-name span {
    color: var(--primary-light);
  }
  .footer-brand p {
    margin-top: 1rem;
    max-width: 32ch;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .footer-email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    color: #cdd8ec;
    font-size: 0.95rem;
  }
  .footer-email:hover {
    color: #fff;
  }
  .socials {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #cdd8ec;
    transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }
  .socials a:hover {
    background: var(--primary);
    color: #fff;
    transform: translateY(-2px);
  }

  .footer-col h3 {
    color: #fff;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }
  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .footer-col a {
    color: #aebbd2;
    font-size: 0.95rem;
  }
  .footer-col a:hover {
    color: #fff;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.85rem;
    color: #8595b0;
  }
  .footer-note {
    color: #6d7c98;
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
