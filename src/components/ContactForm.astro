---
import { site } from '../data/site';
const { web3formsKey } = site;
---

<form id="contact-form" class="contact-form" novalidate>
  <input type="hidden" name="access_key" value={web3formsKey} />
  <input type="hidden" name="subject" value="New message from medicalbeforeaftergallery.com" />
  <input type="hidden" name="from_name" value="MBA Gallery website" />
  <!-- Web3Forms honeypot: bots fill this, humans never see it -->
  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="row">
    <div class="field">
      <label for="cf-name">Name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required placeholder="Jane Doe" />
    </div>
    <div class="field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required placeholder="you@clinic.com" />
    </div>
  </div>

  <div class="field">
    <label for="cf-topic">Topic</label>
    <select id="cf-topic" name="topic">
      <option>General question</option>
      <option>Pre-sales / Pro purchase</option>
      <option>Technical support</option>
      <option>Billing / license</option>
      <option>Feature request</option>
    </select>
  </div>

  <div class="field">
    <label for="cf-message">Message</label>
    <textarea id="cf-message" name="message" rows="6" required placeholder="How can we help?"></textarea>
  </div>

  <button type="submit" class="btn btn-primary btn-lg" id="cf-submit">
    <span class="cf-label">Send message</span>
    <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
  </button>

  <p id="cf-status" class="cf-status" role="status" aria-live="polite"></p>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink);
  }
  input,
  select,
  textarea {
    font-family: inherit;
    font-size: 1rem;
    color: var(--text);
    background: #fff;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.9rem;
    width: 100%;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-100);
  }
  textarea {
    resize: vertical;
  }
  .hp {
    position: absolute !important;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  button[type='submit'] {
    align-self: flex-start;
    margin-top: 0.25rem;
  }
  button[disabled] {
    opacity: 0.7;
    cursor: progress;
  }
  .cf-status {
    font-size: 0.95rem;
    margin: 0;
    min-height: 1.4em;
  }
  .cf-status.success {
    color: var(--accent-dark);
  }
  .cf-status.error {
    color: #dc2626;
  }
  @media (max-width: 540px) {
    .row {
      grid-template-columns: 1fr;
    }
    button[type='submit'] {
      align-self: stretch;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('cf-status');
  const submit = document.getElementById('cf-submit') as HTMLButtonElement | null;
  const label = form?.querySelector('.cf-label');

  if (form && status && submit && label) {
    const keyInput = form.querySelector<HTMLInputElement>('input[name="access_key"]');
    const placeholderKey = !keyInput?.value || keyInput.value.startsWith('YOUR-');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.className = 'cf-status';

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (placeholderKey) {
        status.classList.add('error');
        status.textContent = 'Contact form not configured yet. Please email us directly in the meantime.';
        return;
      }

      submit.disabled = true;
      const original = label.textContent;
      label.textContent = 'Sending…';
      status.textContent = '';

      try {
        const data = Object.fromEntries(new FormData(form));
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (json.success) {
          form.reset();
          status.classList.add('success');
          status.textContent = '✓ Thanks! Your message has been sent — we’ll reply soon.';
        } else {
          status.classList.add('error');
          status.textContent = json.message || 'Something went wrong. Please try again.';
        }
      } catch {
        status.classList.add('error');
        status.textContent = 'Network error — please email us directly.';
      } finally {
        submit.disabled = false;
        label.textContent = original;
      }
    });
  }
</script>
