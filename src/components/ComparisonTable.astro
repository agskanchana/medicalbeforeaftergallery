---
import { comparisonRows, comparisonOverrides } from '../data/comparison';
import { site } from '../data/site';

const cell = (val: boolean) =>
  val
    ? '<span class="ct-yes" aria-label="Included"><i class="fa-solid fa-check"></i></span>'
    : '<span class="ct-no" aria-label="Not included"><i class="fa-solid fa-minus"></i></span>';
---

<div class="comparison">
  <div class="ct-scroll">
    <table class="ct-table">
      <thead>
        <tr>
          <th scope="col">Feature</th>
          <th scope="col">
            <span class="ct-plan">Free</span>
          </th>
          <th scope="col" class="ct-pro-col">
            <span class="ct-plan ct-plan-pro">Pro</span>
          </th>
        </tr>
      </thead>
      <tbody>
        {
          comparisonRows.map((row) => {
            const override = comparisonOverrides[row.feature];
            return (
              <tr>
                <th scope="row">{row.feature}</th>
                <td>{override ? <span class="ct-text">{override.free}</span> : <Fragment set:html={cell(row.free)} />}</td>
                <td class="ct-pro-col">
                  {override ? <span class="ct-text ct-text-pro">{override.pro}</span> : <Fragment set:html={cell(row.pro)} />}
                </td>
              </tr>
            );
          })
        }
        <tr class="ct-actions">
          <td></td>
          <td>
            <a class="btn btn-secondary btn-sm" href={site.wpOrgUrl} target="_blank" rel="noopener noreferrer">Download free</a>
          </td>
          <td class="ct-pro-col">
            <a class="btn btn-primary btn-sm" href="/pricing/">Get Pro</a>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<style>
  .comparison {
    max-width: 820px;
    margin-inline: auto;
  }
  .ct-scroll {
    overflow-x: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    background: #fff;
  }
  .ct-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 520px;
  }
  .ct-table thead th {
    background: var(--bg-soft);
    padding: 1rem;
    font-size: 0.95rem;
    border-bottom: 1px solid var(--border);
  }
  .ct-table thead th:first-child {
    text-align: left;
  }
  .ct-pro-col {
    background: var(--primary-50);
  }
  .ct-plan {
    display: inline-block;
    font-weight: 700;
    color: var(--text);
  }
  .ct-plan-pro {
    color: var(--primary-dark);
  }
  .ct-table tbody th {
    text-align: left;
    font-weight: 500;
    color: var(--text);
    padding: 0.8rem 1rem;
    font-size: 0.95rem;
  }
  .ct-table tbody td {
    text-align: center;
    padding: 0.8rem 1rem;
    border-top: 1px solid var(--border);
  }
  .ct-table tbody th {
    border-top: 1px solid var(--border);
  }
  .ct-yes {
    color: var(--accent-dark);
    font-size: 1rem;
  }
  .ct-no {
    color: var(--text-lighter);
  }
  .ct-text {
    font-weight: 600;
    color: var(--text);
    font-size: 0.9rem;
  }
  .ct-text-pro {
    color: var(--primary-dark);
  }
  .ct-actions td {
    padding: 1.2rem 1rem;
  }
  .btn-sm {
    padding: 0.55rem 1.1rem;
    font-size: 0.85rem;
  }
  tbody tr:hover th,
  tbody tr:hover td {
    background: rgba(60, 136, 253, 0.04);
  }
  tbody tr:hover .ct-pro-col {
    background: var(--primary-100);
  }
</style>
