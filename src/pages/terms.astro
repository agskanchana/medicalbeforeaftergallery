---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
const updated = 'June 2026';
---

<BaseLayout title="Terms of Service" description="The terms that govern use of this website and the MBA Gallery plugin.">
  <section class="legal">
    <div class="container narrow">
      <span class="eyebrow">Legal</span>
      <h1>Terms of Service</h1>
      <p class="updated">Last updated: {updated}</p>

      <div class="prose">
        <p>
          These Terms govern your use of <a href={site.url}>{site.domain}</a> and the Medical Before After Gallery
          plugin (the “Plugin”). By using the Site or Plugin, you agree to these Terms.
        </p>

        <h2>License</h2>
        <p>
          The free Plugin is distributed under the GPL v2 or later. The Pro add-on is sold as a lifetime license
          for a one-time fee and entitles you to updates. Your license permits use on the number of sites included
          with your purchase. The Pro add-on may not be redistributed.
        </p>

        <h2>Payments &amp; refunds</h2>
        <p>
          Pro purchases are processed by our checkout provider, Freemius. We offer a {site.guaranteeDays}-day
          money-back guarantee — contact us within {site.guaranteeDays} days of purchase for a full refund.
        </p>

        <h2>Acceptable use</h2>
        <p>
          You are responsible for the content you publish using the Plugin, including obtaining valid patient
          consent for any before/after images and complying with all applicable medical-advertising and privacy
          laws in your jurisdiction.
        </p>

        <h2>Disclaimer</h2>
        <p>
          The Site and Plugin are provided “as is” without warranties of any kind. We do not warrant that the
          Plugin will be error-free or uninterrupted. To the maximum extent permitted by law, we are not liable
          for any indirect or consequential damages arising from use of the Site or Plugin.
        </p>

        <h2>Changes</h2>
        <p>We may update these Terms from time to time. Continued use of the Site constitutes acceptance of the updated Terms.</p>

        <h2>Contact</h2>
        <p>Questions? <a href="/contact/">Contact us</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .narrow {
    max-width: 760px;
  }
  .legal h1 {
    margin-top: 0.5rem;
  }
  .updated {
    color: var(--text-light);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }
</style>
