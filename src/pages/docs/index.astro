---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';
import { getDocsTree } from '../../utils/docs';
import { site } from '../../data/site';

const tree = await getDocsTree();

const groupIcons: Record<string, string> = {
  'Getting Started': 'fa-solid fa-rocket',
  'Display & Layout': 'fa-solid fa-table-cells-large',
  'Comparison & Discovery': 'fa-solid fa-arrows-left-right',
  Filtering: 'fa-solid fa-filter',
  'Media & Protection': 'fa-solid fa-shield-halved',
  'Privacy & Consent': 'fa-solid fa-user-shield',
  Reference: 'fa-solid fa-code',
  Account: 'fa-solid fa-key',
};
---

<BaseLayout
  title="Documentation"
  description="Setup guides and a full feature reference for the Medical Before After Gallery plugin and Pro add-on."
>
  <div class="docs">
    <div class="container docs-grid">
      <aside class="docs-aside">
        <details class="docs-mobile">
          <summary>Documentation menu</summary>
          <DocsSidebar />
        </details>
        <div class="docs-desktop"><DocsSidebar /></div>
      </aside>

      <div class="docs-content">
        <span class="eyebrow">Documentation</span>
        <h1>How to set up &amp; use MBA Gallery</h1>
        <p class="docs-lead">
          Step-by-step guides and a complete reference for every feature in the free plugin and the Pro add-on.
          New here? Start with <a href="/docs/installation/">Installation &amp; setup</a>.
        </p>

        <div class="group-cards">
          {
            tree.map((group) => (
              <section class="group-card card">
                <div class="gc-head">
                  <span class="gc-icon"><i class={groupIcons[group.name] ?? 'fa-solid fa-book'} aria-hidden="true" /></span>
                  <h2>{group.name}</h2>
                </div>
                <ul>
                  {group.items.map((item) => (
                    <li>
                      <a href={`/docs/${item.id}/`}>
                        <span>{item.data.title}</span>
                        <i class="fa-solid fa-arrow-right" aria-hidden="true" />
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>

        <div class="docs-help card">
          <div>
            <h3>Can’t find what you need?</h3>
            <p>Check the FAQ or reach out — we’re happy to help.</p>
          </div>
          <div class="help-actions">
            <a href="/faq/" class="btn btn-secondary">Read the FAQ</a>
            <a href="/contact/" class="btn btn-primary">Contact us</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .docs {
    padding-block: 2.5rem 4rem;
  }
  .docs-grid {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
  }
  .docs-aside {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    align-self: start;
    max-height: calc(100vh - var(--header-h) - 3rem);
    overflow-y: auto;
  }
  .docs-mobile {
    display: none;
  }
  .docs-content h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin-top: 0.4rem;
  }
  .docs-lead {
    font-size: 1.1rem;
    color: var(--text-light);
    margin-top: 0.75rem;
    max-width: 60ch;
  }
  .docs-lead a {
    text-decoration: underline;
  }
  .group-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .group-card {
    padding: 1.5rem;
  }
  .gc-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .gc-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    background: var(--primary-50);
    color: var(--primary);
  }
  .gc-head h2 {
    font-size: 1.15rem;
  }
  .group-card ul {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .group-card li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0;
    color: var(--text);
    border-bottom: 1px solid var(--border);
  }
  .group-card li:last-child a {
    border-bottom: none;
  }
  .group-card li a i {
    color: var(--text-lighter);
    font-size: 0.8rem;
    transition: transform 0.18s ease, color 0.18s ease;
  }
  .group-card li a:hover {
    color: var(--primary-dark);
  }
  .group-card li a:hover i {
    color: var(--primary);
    transform: translateX(3px);
  }
  .docs-help {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding: 1.75rem;
    background: var(--gradient-soft);
  }
  .docs-help h3 {
    font-size: 1.2rem;
  }
  .docs-help p {
    color: var(--text-light);
    margin-top: 0.25rem;
  }
  .help-actions {
    display: flex;
    gap: 0.6rem;
  }

  @media (max-width: 820px) {
    .docs-grid {
      grid-template-columns: 1fr;
    }
    .docs-aside {
      position: static;
      max-height: none;
      overflow: visible;
    }
    .docs-desktop {
      display: none;
    }
    .docs-mobile {
      display: block;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.5rem 1rem;
      background: #fff;
    }
    .docs-mobile summary {
      cursor: pointer;
      font-weight: 600;
      padding: 0.4rem 0;
    }
  }
  @media (max-width: 560px) {
    .group-cards {
      grid-template-columns: 1fr;
    }
    .help-actions {
      width: 100%;
    }
    .help-actions .btn {
      flex: 1;
    }
  }
</style>
