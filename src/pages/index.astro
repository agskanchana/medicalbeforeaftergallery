---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import Testimonials from '../components/Testimonials.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import CtaBanner from '../components/CtaBanner.astro';
import FreemiusCheckout from '../components/FreemiusCheckout.astro';
import FeatureShowcase from '../components/FeatureShowcase.astro';
import FeatureCards from '../components/FeatureCards.astro';
import VideoTour from '../components/VideoTour.astro';
import { showcase, setupSteps } from '../data/showcase';
import { faqItems } from '../data/faq';
import { site } from '../data/site';
import { demoSections, liveDemos } from '../utils/demos';

const practiceTypes = [
  { icon: 'fa-solid fa-user-doctor', label: 'Plastic surgery', href: '/for/plastic-surgery/' },
  { icon: 'fa-solid fa-hand-sparkles', label: 'Dermatology', href: '/for/dermatology/' },
  { icon: 'fa-solid fa-tooth', label: 'Dental', href: '/for/dental/' },
  { icon: 'fa-solid fa-spa', label: 'Med spas', href: '/for/med-spa/' },
  { icon: 'fa-solid fa-weight-scale', label: 'Weight loss', href: '/for/weight-loss/' },
  { icon: 'fa-solid fa-scissors', label: 'Hair restoration', href: '/for/hair-restoration/' },
];

const groupIcons: Record<string, string> = {
  free: 'fa-brands fa-wordpress',
  layouts: 'fa-solid fa-table-cells-large',
  categories: 'fa-solid fa-icons',
  templates: 'fa-solid fa-swatchbook',
  browse: 'fa-solid fa-filter',
  window: 'fa-solid fa-window-maximize',
  embeds: 'fa-solid fa-code',
  protect: 'fa-solid fa-shield-halved',
};

// Software + rating, matching the rating shown in the testimonials section.
const homeTitle = 'Medical Before After Gallery (MBA Gallery) — before and after galleries for clinics';
const homeDescription =
  'Medical Before After Gallery (MBA Gallery) is a WordPress plugin for before and after photo galleries in clinics: free on WordPress.org, with a Pro add-on for layouts, case windows, progress timelines, single-case embeds and watermarks.';

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.legalName,
  alternateName: site.name,
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'WordPress plugin',
  operatingSystem: 'WordPress',
  softwareVersion: site.freeVersion,
  description: homeDescription,
  url: site.url + '/',
  publisher: { '@id': `${site.url}/#organization` },
  downloadUrl: site.wpOrgUrl,
  image: new URL('/images/features/window-cinema.webp', site.url).href,
  offers: [
    { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD', url: site.wpOrgUrl },
    {
      '@type': 'Offer',
      name: 'Pro (lifetime license)',
      price: String(site.proPrice),
      priceCurrency: site.currency,
      description: 'One-time payment, lifetime license with updates',
      url: site.url + '/pricing/',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.wpOrg.rating,
    ratingCount: site.wpOrg.ratingCount,
    reviewCount: site.wpOrg.ratingCount,
    bestRating: '5',
    worstRating: '1',
  },
};
---

<BaseLayout fullTitle={homeTitle} description={homeDescription} jsonLd={softwareJsonLd}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <span class="eyebrow"><i class="fa-brands fa-wordpress" aria-hidden="true"></i> WordPress plugin for clinics</span>
        <h1>Show your patients real <span class="grad">before &amp; after</span> results</h1>
        <p class="lead">
          <strong>Medical Before After Gallery (MBA Gallery)</strong> is a before and after gallery for medical and aesthetic
          practices. The free plugin gives you a comparison slider, categories and doctor cards. Pro adds layouts, case windows,
          progress timelines, single-case embeds, watermarks and more.
        </p>
        <div class="hero-cta">
          <FreemiusCheckout label={`Get Pro — $${site.proPrice} one-time`} class="btn btn-primary btn-lg" />
          <a class="btn btn-secondary btn-lg" href={site.wpOrgUrl} target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-wordpress" aria-hidden="true"></i> Download free
          </a>
        </div>
        <ul class="hero-meta">
          <li>
            <a href={site.wpOrgReviewsUrl} target="_blank" rel="noopener noreferrer">
              <span class="hero-stars" aria-hidden="true">
                {Array.from({ length: 5 }).map(() => <i class="fa-solid fa-star" />)}
              </span>
              {site.wpOrg.rating} on WordPress.org · {site.wpOrg.ratingCount} reviews
            </a>
          </li>
          <li><i class="fa-solid fa-check" aria-hidden="true"></i> {site.guaranteeDays}-day money-back</li>
          <li><a href="/demo/"><i class="fa-solid fa-play" aria-hidden="true"></i> {liveDemos.length} live demos</a></li>
        </ul>
      </div>

      <div class="hero-media">
        <a class="hero-frame" href="#tour">
          <span class="bar" aria-hidden="true"><span></span><span></span><span></span></span>
          <img
            src="/images/features/window-cinema.webp"
            alt="Screenshot of the Pro Cinema case window: a hair transplant case shown full screen with a timeline of its progress photos"
            width="1600"
            height="900"
            loading="eager"
            fetchpriority="high"
          />
          <span class="hero-play"><i class="fa-solid fa-play" aria-hidden="true"></i> Watch the feature video</span>
        </a>
        <p class="hero-versions">
          <span class="badge badge-free">Free {site.freeVersion}</span>
          <span class="badge badge-pro">Pro {site.proVersion}</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ TRUST STRIP ============ -->
  <section class="trust" aria-labelledby="trust-label">
    <div class="container">
      <h2 class="trust-label" id="trust-label">Made for</h2>
      <ul class="trust-list">
        {
          practiceTypes.map((p) => (
            <li>
              <a class="trust-item" href={p.href}>
                <i class={p.icon} aria-hidden="true" /> {p.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ VIDEO ============ -->
  <section class="section" id="tour" aria-label="Feature video">
    <div class="container">
      <div class="section-head">
        <h2>See Pro at work</h2>
        <p>The main Pro features, in under a minute.</p>
      </div>
      <VideoTour />
    </div>
  </section>

  <!-- ============ FEATURES ============ -->
  <section class="section section-soft" id="features">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What’s new: free {site.freeVersion} · Pro {site.proVersion}</span>
        <h2>Built around how patients look at results</h2>
        <p>Each screenshot is from the demo site, and each one links to the page where you can try it.</p>
      </div>
      <FeatureShowcase items={showcase} />
    </div>
  </section>

  <section class="section" id="more-features">
    <div class="container">
      <div class="section-head">
        <h2>Put cases where patients read about a treatment</h2>
        <p>Embeds, doctors, page structures and other ways to browse.</p>
      </div>
      <FeatureCards />

      <article class="setup card reveal" id="setup">
        <div class="setup-intro">
          <span class="badge badge-pro">Pro</span>
          <h3>Setup wizard and ready-to-publish checks</h3>
          <p>
            A new gallery starts with a short wizard. Afterwards, the Overview lists the cases that need attention before you
            publish them, with a Ready column in the case list.
          </p>
          <a href="/docs/setup-wizard-and-ready-to-publish/" class="setup-link">
            How it works <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
        <div class="setup-lists">
          <div>
            <h4>The wizard asks for</h4>
            <ol class="steps">
              {setupSteps.wizard.map((s) => <li>{s}</li>)}
            </ol>
          </div>
          <div>
            <h4>The checks look for</h4>
            <ul class="checks">
              {setupSteps.checks.map((c) => (
                <li>
                  <i class="fa-solid fa-circle-exclamation" aria-hidden="true" /> {c}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </article>

      <div class="text-center" style="margin-top:2.5rem;">
        <a href="/features/" class="btn btn-secondary">All features <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>

  <!-- ============ DEMOS ============ -->
  <section class="section section-soft" id="demo">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Live demos</span>
        <h2>Try each feature on its own page</h2>
        <p>
          {liveDemos.length} working demo pages with the same sample cases. Filter, open a case, drag the slider, step through
          the stages.
        </p>
      </div>
      <ul class="demo-groups">
        {
          demoSections.map((s) => (
            <li>
              <a href={`/demo/#${s.id}`} class="demo-group card">
                <span class="dg-icon">
                  <i class={groupIcons[s.id]} aria-hidden="true" />
                </span>
                <span class="dg-text">
                  <strong>
                    {s.title} <span class:list={['badge', s.tier === 'pro' ? 'badge-pro' : 'badge-free']}>{s.tier === 'pro' ? 'Pro' : 'Free'}</span>
                  </strong>
                  <small>
                    {s.count} demo{s.count === 1 ? '' : 's'} · {s.intro}
                  </small>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="text-center" style="margin-top:2rem;">
        <a href="/demo/" class="btn btn-primary btn-lg">See all demos <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>

  <!-- ============ COMPARISON ============ -->
  <section class="section" id="comparison">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Free vs Pro</span>
        <h2>Start free, upgrade when you need more</h2>
        <p>The free plugin is a complete gallery for up to 12 cases. Pro removes the limits and adds the rest.</p>
      </div>
      <ComparisonTable />
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="section section-soft" id="testimonials">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Reviews</span>
        <h2>What users say on WordPress.org</h2>
      </div>
      <Testimonials />
    </div>
  </section>

  <!-- ============ PRICING ============ -->
  <section class="section" id="pricing">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Pricing</span>
        <h2>Free, or one payment for Pro</h2>
        <p>No subscription. Pay once for Pro and keep it, with updates.</p>
      </div>
      <Pricing />
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section section-soft" id="faq">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">FAQ</span>
        <h2>Frequently asked questions</h2>
      </div>
      <Faq items={faqItems.slice(0, 6)} />
      <div class="text-center" style="margin-top:1.75rem;">
        <a href="/faq/" class="btn btn-ghost">All questions <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>

  <CtaBanner />

  <p class="container credits">
    Screenshots and the video show the demo site’s sample content: the doctors are fictional, some photos were created with an
    image model, and three cases use photos from Wikimedia Commons (Alexander Rivkin, CC BY-SA 3.0; Yvul, CC BY-SA 4.0), as each
    of those cases says on the demo site.
  </p>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    background: linear-gradient(180deg, #f6f9fe 0%, #ffffff 78%);
    padding-top: clamp(2rem, 5vw, 4rem);
    overflow: hidden;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(1.5rem, 4vw, 3.5rem) clamp(2.5rem, 5vw, 4.5rem);
  }
  .hero h1 {
    margin-top: 0.25rem;
  }
  .grad {
    color: var(--primary-dark);
  }
  .hero .lead {
    margin-top: 1.25rem;
    max-width: 46ch;
    line-height: 1.7;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.9rem;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    margin-top: 1.4rem;
    font-size: 0.9rem;
    color: var(--text-light);
  }
  .hero-meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero-meta a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hero-meta a:hover {
    color: var(--primary-dark);
  }
  .hero-meta .fa-check {
    color: var(--accent-text);
  }
  .hero-stars {
    display: inline-flex;
    gap: 0.1rem;
    color: var(--star);
    font-size: 0.8rem;
  }
  .hero-media {
    min-width: 0;
  }
  .hero-frame {
    position: relative;
    display: block;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    transition: transform 0.25s ease;
  }
  .hero-frame:hover {
    transform: translateY(-3px);
  }
  .hero-frame .bar {
    display: flex;
    gap: 0.4rem;
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
  }
  .hero-frame .bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .hero-frame img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .hero-play {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-pill);
    background: rgba(15, 27, 51, 0.86);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .hero-versions {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
    margin-top: 0.85rem;
  }

  /* Trust strip */
  .trust {
    padding-block: 1.75rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: #fff;
  }
  .trust-label {
    text-align: center;
    color: var(--text-light);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }
  .trust-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    justify-content: center;
  }
  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    font-weight: 500;
    font-size: 0.95rem;
  }
  a.trust-item {
    padding: 0.35rem 0.2rem;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 4px;
  }
  a.trust-item:hover {
    color: var(--primary-dark);
    text-decoration-color: currentColor;
  }
  .trust-item i {
    color: var(--primary-dark);
  }

  /* Setup panel */
  .setup {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: 2.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .setup h3 {
    margin: 0.75rem 0 0.5rem;
  }
  .setup-intro p {
    color: var(--text-light);
  }
  .setup-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    font-weight: 600;
  }
  .setup-lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .setup-lists h4 {
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }
  .steps {
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .steps li {
    counter-increment: step;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.95rem;
  }
  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--primary-50);
    color: var(--primary-darker);
    font-weight: 700;
    font-size: 0.8rem;
  }
  .checks {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.95rem;
  }
  .checks li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
  }
  .checks i {
    color: #b45309;
    margin-top: 0.3em;
  }

  /* Demo groups */
  .demo-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .demo-group {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    height: 100%;
    padding: 1.2rem 1.3rem;
    color: var(--text);
  }
  .dg-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 12px;
    background: var(--primary-50);
    color: var(--primary-dark);
    font-size: 1.1rem;
  }
  .dg-text strong {
    display: block;
    color: var(--ink);
    font-size: 1rem;
  }
  .dg-text small {
    display: block;
    color: var(--text-light);
    font-size: 0.86rem;
    line-height: 1.45;
    margin-top: 0.2rem;
  }

  .credits {
    color: var(--text-light);
    font-size: 0.8rem;
    text-align: center;
    max-width: 760px;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 980px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-content {
      text-align: center;
    }
    .hero .lead {
      margin-inline: auto;
    }
    .hero-cta,
    .hero-meta {
      justify-content: center;
    }
    .hero-versions {
      justify-content: center;
    }
    .setup {
      grid-template-columns: 1fr;
    }
    .demo-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .setup-lists,
    .demo-groups {
      grid-template-columns: 1fr;
    }
    .hero-cta .btn {
      width: 100%;
    }
    .hero-play {
      font-size: 0.8rem;
      padding: 0.45rem 0.8rem;
    }
  }
</style>
