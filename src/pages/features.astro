---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import CtaBanner from '../components/CtaBanner.astro';
import FeatureShowcase from '../components/FeatureShowcase.astro';
import { featureGroups } from '../data/features';
import { site } from '../data/site';
---

<BaseLayout
  title="Features"
  description="Every feature of the Medical Before After Gallery plugin — comparison sliders, smart filtering, watermarking, image annotations, consent overlay, masonry layout and more."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Features</span>
      <h1>Everything you need to present <span class="grad">before &amp; after</span> results</h1>
      <p class="lead">
        A complete toolkit for medical and aesthetic practices — from a simple comparison slider to full,
        filterable case studies with watermarking and consent. <strong>Pro</strong> features are marked below.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">In action</span>
        <h2>See the highlights</h2>
        <p>
          A closer look at the features that make MBA Gallery stand out.
          <a href={site.demoUrl} target="_blank" rel="noopener noreferrer">Open the live demo →</a>
        </p>
      </div>
      <FeatureShowcase />
    </div>
  </section>

  {
    featureGroups.map((group, i) => (
      <section class:list={['section', { 'section-soft': i % 2 === 0 }]} id={group.id}>
        <div class="container">
          <div class="group-head">
            <div class="group-icon"><i class={group.icon} aria-hidden="true" /></div>
            <div>
              <h2>{group.title}</h2>
              <p>{group.description}</p>
            </div>
          </div>
          <div class="feat-grid">
            {group.features.map((f) => (
              <article class="feat-card card reveal">
                <div class="feat-icon"><i class={f.icon} aria-hidden="true" /></div>
                <h3>
                  {f.title}
                  {f.tier === 'pro' ? (
                    <span class="badge badge-pro">Pro</span>
                  ) : (
                    <span class="badge badge-free">Free</span>
                  )}
                </h3>
                <p>{f.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Free vs Pro</span>
        <h2>Compare the plans</h2>
      </div>
      <ComparisonTable />
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .page-hero {
    background: var(--gradient-soft);
    padding-block: clamp(2.75rem, 7vw, 4.5rem);
    text-align: center;
  }
  .page-hero .lead {
    max-width: 58ch;
    margin: 1rem auto 0;
  }
  .grad {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .group-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .group-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 16px;
    background: var(--gradient-primary);
    color: #fff;
    font-size: 1.4rem;
    box-shadow: var(--shadow-primary);
  }
  .group-head h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
  }
  .group-head p {
    color: var(--text-light);
    margin-top: 0.2rem;
  }
  .feat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .feat-card {
    padding: 1.6rem;
  }
  .feat-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 13px;
    background: var(--primary-50);
    color: var(--primary);
    font-size: 1.15rem;
    margin-bottom: 1rem;
  }
  .feat-card h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 1.1rem;
    margin-bottom: 0.45rem;
  }
  .feat-card p {
    color: var(--text-light);
    font-size: 0.95rem;
  }
  @media (max-width: 900px) {
    .feat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .feat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
