---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';

const channels = [
  {
    icon: 'fa-solid fa-book-open',
    title: 'Read the docs',
    body: 'Setup guides & feature reference',
    href: '/docs/',
  },
  {
    icon: 'fa-brands fa-wordpress',
    title: 'Support forum',
    body: 'Community support on WordPress.org',
    href: 'https://wordpress.org/support/plugin/medical-before-after-gallery/',
  },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with the Medical Before After Gallery team for pre-sales questions, support or feature requests."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Let’s <span class="grad">talk</span></h1>
      <p class="lead">
        Questions about the plugin, Pro licensing or setup? Send us a message and we’ll get back to you,
        usually within one business day.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-aside">
        <h2>Other ways to reach us</h2>
        <ul class="channels">
          {
            channels.map((c) => (
              <li>
                <a
                  href={c.href}
                  target={c.href.startsWith('http') ? '_blank' : undefined}
                  rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  <span class="ch-icon"><i class={c.icon} aria-hidden="true" /></span>
                  <span>
                    <strong>{c.title}</strong>
                    <span class="ch-body">{c.body}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="contact-note">
          <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
          <p>Please don’t send patient images or any protected health information through this form.</p>
        </div>
      </div>

      <div class="contact-card card">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: var(--gradient-soft);
    padding-block: clamp(2.75rem, 7vw, 4.5rem);
    text-align: center;
  }
  .page-hero .lead {
    max-width: 52ch;
    margin: 1rem auto 0;
  }
  .grad {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  .contact-aside h2 {
    font-size: 1.3rem;
    margin-bottom: 1.25rem;
  }
  .channels {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .channels a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #fff;
    color: var(--text);
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }
  .channels a:hover {
    border-color: var(--primary-100);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }
  .ch-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 11px;
    background: var(--primary-50);
    color: var(--primary);
  }
  .channels strong {
    display: block;
    color: var(--ink);
    font-size: 0.98rem;
  }
  .ch-body {
    display: block;
    color: var(--text-light);
    font-size: 0.88rem;
  }
  .contact-note {
    display: flex;
    gap: 0.65rem;
    margin-top: 1.5rem;
    padding: 0.9rem 1rem;
    background: var(--accent-50);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 0.88rem;
  }
  .contact-note i {
    color: var(--accent-dark);
    margin-top: 0.15rem;
  }
  .contact-card {
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }
  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .contact-aside {
      order: 2;
    }
  }
</style>
