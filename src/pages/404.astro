---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex={true}>
  <section class="notfound">
    <div class="container">
      <span class="code">404</span>
      <h1>This page took a detour</h1>
      <p class="lead">The page you’re looking for doesn’t exist or may have moved.</p>
      <div class="nf-actions">
        <a href="/" class="btn btn-primary btn-lg"><i class="fa-solid fa-house"></i> Back home</a>
        <a href="/docs/" class="btn btn-secondary btn-lg">Browse the docs</a>
      </div>
      <div class="nf-links">
        <a href="/features/">Features</a>
        <a href="/pricing/">Pricing</a>
        <a href="/blog/">Blog</a>
        <a href="/faq/">FAQ</a>
        <a href="/contact/">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding-block: clamp(3.5rem, 12vw, 7rem);
    background: var(--gradient-soft);
  }
  .code {
    display: inline-block;
    font-size: clamp(4rem, 16vw, 8rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .notfound h1 {
    margin-top: 0.5rem;
  }
  .notfound .lead {
    margin-top: 0.75rem;
  }
  .nf-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }
  .nf-links {
    display: flex;
    gap: 1.25rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2.5rem;
    font-size: 0.95rem;
  }
</style>
