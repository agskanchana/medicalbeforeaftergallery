---
// Landing page for the live demos. One card per working demo page, grouped as on the demo
// site. The list is src/data/demos.ts; a page is shown only while it passes the browser check
// in scripts/capture-demo-shots.mjs (src/data/demo-check.json).
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { site } from '../data/site';
import { demoSections, liveDemos } from '../utils/demos';

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Medical Before After Gallery live demos',
  numberOfItems: liveDemos.length,
  itemListElement: demoSections
    .flatMap((s) => s.families.flatMap((f) => f.items))
    .map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.title, url: d.url })),
};
---

<BaseLayout
  title="Live demos"
  description={`Try every feature of the Medical Before After Gallery plugin on its own live demo page: ${liveDemos.length} pages covering the free plugin and the Pro layouts, category styles, case windows, embeds and protection.`}
  jsonLd={itemListJsonLd}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Live demos</span>
      <h1>Try every feature, <span class="grad">live</span></h1>
      <p class="lead">
        {liveDemos.length} demo pages, each showing one thing the free plugin or the Pro add-on can do, with the same sample
        cases. Every page works: filter the cases, open one, drag the slider, step through the stages.
      </p>
      <nav class="jump" aria-label="Demo groups">
        {
          demoSections.map((s) => (
            <a href={`#${s.id}`}>
              {s.title} <span class="count">{s.count}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  {
    demoSections.map((section, i) => (
      <section class:list={['section', 'demo-section', { 'section-soft': i % 2 === 1 }]} id={section.id} aria-labelledby={`${section.id}-title`}>
        <div class="container">
          <header class="group-head">
            <span class:list={['badge', section.tier === 'pro' ? 'badge-pro' : 'badge-free']}>{section.tier === 'pro' ? 'Pro' : 'Free'}</span>
            <h2 id={`${section.id}-title`}>{section.title}</h2>
            <p>{section.intro}</p>
          </header>
          {section.families.map((family) => (
            <div class="family">
              {section.families.length > 1 && <h3 class="family-title">{family.name}</h3>}
              <ul class="demo-grid">
                {family.items.map((d) => (
                  <li class="demo-card card">
                    <div class="demo-shot">
                      <img src={d.image} alt={`Screenshot: ${d.shot}`} width="800" height="450" loading="lazy" decoding="async" />
                    </div>
                    <div class="demo-body">
                      <h4>
                        <a href={d.url} target="_blank" rel="noopener" class="demo-link">
                          {d.title}
                          <span class="sr-only"> — open the live demo (new tab)</span>
                        </a>
                      </h4>
                      <p>{d.description}</p>
                      <span class="demo-go" aria-hidden="true">
                        Open live demo <i class="fa-solid fa-arrow-up-right-from-square" />
                      </span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ))
  }

  <section class="section">
    <div class="container about">
      <h2>About the demo site</h2>
      <p>
        The demos run on <a href={site.demoSite} target="_blank" rel="noopener">demo.medicalbeforeaftergallery.com</a>, a static copy of
        a WordPress site with the free plugin {site.freeVersion} and Pro {site.proVersion}. Each page says how to turn its feature on.
        The cases are sample content: the doctors are fictional, some photos were created with an image model, and three cases use
        photos from Wikimedia Commons (Alexander Rivkin, CC BY-SA 3.0; Yvul, CC BY-SA 4.0), as each of those cases says.
      </p>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .page-hero {
    background: var(--gradient-soft);
    padding-block: clamp(2.75rem, 7vw, 4.5rem);
    text-align: center;
  }
  .page-hero .lead {
    max-width: 60ch;
    margin: 1rem auto 0;
  }
  .grad {
    color: var(--primary-dark);
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    background: #fff;
    border: 1px solid var(--border-strong);
    color: var(--text);
    font-weight: 500;
    font-size: 0.92rem;
  }
  .jump a:hover {
    border-color: var(--primary-light);
    color: var(--primary-dark);
  }
  .jump .count {
    display: inline-grid;
    place-items: center;
    min-width: 1.6rem;
    height: 1.6rem;
    padding: 0 0.35rem;
    border-radius: var(--radius-pill);
    background: var(--primary-50);
    color: var(--primary-darker);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .demo-section {
    padding-block: clamp(3rem, 7vw, 5rem);
    scroll-margin-top: var(--header-h);
  }
  .group-head {
    max-width: 680px;
    margin-bottom: 2rem;
  }
  .group-head h2 {
    margin-top: 0.6rem;
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
  }
  .group-head p {
    color: var(--text-light);
    margin-top: 0.4rem;
  }
  .family + .family {
    margin-top: 2.25rem;
  }
  .family-title {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    color: var(--text);
  }
  .demo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 1.25rem;
  }
  .demo-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .demo-shot {
    aspect-ratio: 16 / 9;
    background: var(--bg-softer);
    border-bottom: 1px solid var(--border);
  }
  .demo-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .demo-body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.1rem 1.2rem 1.25rem;
    flex: 1;
  }
  .demo-body h4 {
    font-size: 1.02rem;
  }
  .demo-link {
    color: var(--ink);
  }
  /* The whole card is the link's target area. */
  .demo-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .demo-link:focus-visible {
    outline: none;
  }
  .demo-card:has(.demo-link:focus-visible) {
    outline: 3px solid var(--primary-light);
    outline-offset: 2px;
  }
  .demo-body p {
    color: var(--text-light);
    font-size: 0.92rem;
    flex: 1;
  }
  .demo-go {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.3rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--primary-dark);
  }
  .demo-card:hover .demo-link {
    color: var(--primary-dark);
  }

  .about {
    max-width: 760px;
  }
  .about h2 {
    font-size: 1.4rem;
  }
  .about p {
    margin-top: 0.75rem;
    color: var(--text-light);
  }
  .about a {
    text-decoration: underline;
  }
</style>
