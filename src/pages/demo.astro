---
// The one landing page for all live demos. A "Start here" row, then the Pro demos in groups,
// then the free plugin's. The list is src/data/demos.ts; a page is linked only while it passes
// the browser check in scripts/capture-demo-shots.mjs (src/data/demo-check.json).
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import DemoCard from '../components/DemoCard.astro';
import { site } from '../data/site';
import { demoUrl } from '../data/demos';
import { demoSections, liveDemos, startHere } from '../utils/demos';

const pro = demoSections.filter((s) => s.tier === 'pro');
const free = demoSections.filter((s) => s.tier === 'free');

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Medical Before After Gallery live demos',
  numberOfItems: liveDemos.length,
  itemListElement: liveDemos.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.title, url: demoUrl(d.path) })),
};
---

<BaseLayout
  title="Live demos"
  description={`${liveDemos.length} working demos of the Medical Before After Gallery plugin: Pro case windows, layouts and cards, category styles with icons, embeds, design templates and photo protection, and the free plugin.`}
  jsonLd={itemListJsonLd}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Live demos</span>
      <h1>Try it <span class="grad">live</span></h1>
      <p class="lead">
        {liveDemos.length} working demos with the same sample cases. Filter, open a case, drag the slider, step through the
        stages.
      </p>
      <nav class="jump" aria-label="Demo groups">
        {
          demoSections.map((s) => (
            <a href={`#${s.id}`}>
              {s.title} <span class="count">{s.count}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="section demo-section" id="start" aria-labelledby="start-title">
    <div class="container">
      <header class="group-head">
        <span class="badge badge-pro">Pro</span>
        <h2 id="start-title">Start here</h2>
        <p>Four demos to see first.</p>
      </header>
      <ul class="demo-grid demo-grid-start">
        {startHere.map((c) => <DemoCard card={c} />)}
      </ul>
    </div>
  </section>

  {
    pro.map((section, i) => (
      <section class:list={['section', 'demo-section', { 'section-soft': i % 2 === 0 }]} id={section.id} aria-labelledby={`${section.id}-title`}>
        <div class="container">
          <header class="group-head">
            <span class="badge badge-pro">Pro</span>
            <h2 id={`${section.id}-title`}>{section.title}</h2>
            <p>{section.intro}</p>
          </header>
          <ul class="demo-grid">
            {section.cards.map((c) => <DemoCard card={c} />)}
          </ul>
        </div>
      </section>
    ))
  }

  {
    free.map((section) => (
      <section class:list={['section', 'demo-section', { 'section-soft': pro.length % 2 === 0 }]} id={section.id} aria-labelledby={`${section.id}-title`}>
        <div class="container">
          <header class="group-head">
            <span class="badge badge-free">Free</span>
            <h2 id={`${section.id}-title`}>{section.title}</h2>
            <p>{section.intro}</p>
          </header>
          <ul class="free-list">
            {section.cards.map((c) => (
              <li class="free-item card">
                <img src={c.image} alt={c.alt} width="160" height="90" loading="lazy" decoding="async" />
                <div>
                  <h3 class="free-title">
                    <a href={c.url} target="_blank" rel="noopener" class="free-link">
                      {c.title}
                      <span class="sr-only"> — open the demo (new tab)</span>
                    </a>
                  </h3>
                  <p>{c.line}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class:list={['section', { 'section-soft': pro.length % 2 === 1 }]}>
    <div class="container about">
      <h2>About the demo site</h2>
      <p>
        The demos run on demo.medicalbeforeaftergallery.com, a static copy of a WordPress site with the free plugin
        {' '}{site.freeVersion} and Pro {site.proVersion}. Each page says how to turn its feature on. The cases are sample
        content: the doctors are fictional, some photos were created with an image model, and three cases use photos from
        Wikimedia Commons (Alexander Rivkin, CC BY-SA 3.0; Yvul, CC BY-SA 4.0), as each of those cases says.
      </p>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .page-hero {
    background: var(--gradient-soft);
    padding-block: clamp(2.75rem, 7vw, 4.5rem);
    text-align: center;
  }
  .page-hero .lead {
    max-width: 60ch;
    margin: 1rem auto 0;
  }
  .grad {
    color: var(--primary-dark);
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    background: #fff;
    border: 1px solid var(--border-strong);
    color: var(--text);
    font-weight: 500;
    font-size: 0.92rem;
  }
  .jump a:hover {
    border-color: var(--primary-light);
    color: var(--primary-dark);
  }
  .jump .count {
    display: inline-grid;
    place-items: center;
    min-width: 1.6rem;
    height: 1.6rem;
    padding: 0 0.35rem;
    border-radius: var(--radius-pill);
    background: var(--primary-50);
    color: var(--primary-darker);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .demo-section {
    padding-block: clamp(2.5rem, 6vw, 4.25rem);
    scroll-margin-top: var(--header-h);
  }
  .group-head {
    max-width: 680px;
    margin-bottom: 2rem;
  }
  .group-head h2 {
    margin-top: 0.6rem;
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
  }
  .group-head p {
    color: var(--text-light);
    margin-top: 0.4rem;
  }
  .demo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: 1.25rem;
  }
  .demo-grid-start {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
  }
  .free-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 0.9rem;
  }
  .free-item {
    position: relative;
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 0.75rem;
  }
  .free-item img {
    flex: none;
    width: 120px;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .free-title {
    font-size: 0.98rem;
  }
  .free-item p {
    color: var(--text-light);
    font-size: 0.86rem;
    margin-top: 0.2rem;
  }
  .free-link {
    color: var(--ink);
  }
  .free-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .free-link:focus-visible {
    outline: none;
  }
  .free-item:has(.free-link:focus-visible) {
    outline: 3px solid var(--primary-light);
    outline-offset: 2px;
  }
  .free-item:hover .free-link {
    color: var(--primary-dark);
  }

  .about {
    max-width: 760px;
  }
  .about h2 {
    font-size: 1.4rem;
  }
  .about p {
    margin-top: 0.75rem;
    color: var(--text-light);
  }
  .about a {
    text-decoration: underline;
  }
</style>
