---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FreemiusCheckout from '../components/FreemiusCheckout.astro';
import { formatDate, isoDate, slugifyTag } from '../utils/format';
import { site } from '../data/site';

interface Props {
  post: CollectionEntry<'blog'>;
  readMinutes: string;
}
const { post, readMinutes } = Astro.props;
const { title, description, date, updated, author, category, image, imageAlt, tags } = post.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: image ? [image] : undefined,
  datePublished: isoDate(date),
  dateModified: isoDate(updated ?? date),
  author: { '@type': 'Person', name: author },
  publisher: {
    '@type': 'Organization',
    name: site.legalName,
    logo: { '@type': 'ImageObject', url: `${site.url}/100-100.jpg` },
  },
  mainEntityOfPage: `${site.url}/blog/${post.id}/`,
};
---

<BaseLayout title={title} description={description} image={image} type="article" jsonLd={jsonLd}>
  <article class="post">
    <header class="post-header">
      <div class="container narrow">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/blog/">Blog</a> <span aria-hidden="true">/</span>
          {category && <span>{category}</span>}
        </nav>
        <h1>{title}</h1>
        <div class="post-meta">
          <span><i class="fa-regular fa-calendar" aria-hidden="true"></i> {formatDate(date)}</span>
          <span><i class="fa-regular fa-user" aria-hidden="true"></i> {author}</span>
          <span><i class="fa-regular fa-clock" aria-hidden="true"></i> {readMinutes}</span>
        </div>
      </div>
    </header>

    {
      image && (
        <div class="container narrow">
          <img class="post-cover" src={image} alt={imageAlt ?? title} width="1200" height="630" />
        </div>
      )
    }

    <div class="container narrow">
      <div class="prose post-body">
        <slot />
      </div>

      {
        tags.length > 0 && (
          <div class="post-tags">
            {tags.map((t) => (
              <a href={`/blog/tags/${slugifyTag(t)}/`} class="tag">
                #{t}
              </a>
            ))}
          </div>
        )
      }

      <div class="post-cta card">
        <div>
          <h3>Try it on your own site</h3>
          <p>Install the free plugin from WordPress.org, or unlock everything with a ${site.proPrice} lifetime Pro license.</p>
        </div>
        <div class="post-cta-actions">
          <FreemiusCheckout label="Get Pro" class="btn btn-primary" />
          <a class="btn btn-secondary" href={site.wpOrgUrl} target="_blank" rel="noopener noreferrer">Download free</a>
        </div>
      </div>

      <a href="/blog/" class="back-link"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to all articles</a>
    </div>
  </article>
</BaseLayout>

<style>
  .narrow {
    max-width: 760px;
  }
  .post-header {
    background: var(--gradient-soft);
    padding-block: clamp(2.25rem, 6vw, 3.5rem);
    margin-bottom: 2rem;
  }
  .crumbs {
    font-size: 0.85rem;
    color: var(--text-light);
    margin-bottom: 1rem;
    display: flex;
    gap: 0.5rem;
  }
  .crumbs a {
    color: var(--primary-dark);
  }
  .post-header h1 {
    font-size: clamp(1.8rem, 4.2vw, 2.7rem);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.1rem;
    color: var(--text-light);
    font-size: 0.9rem;
  }
  .post-meta i {
    color: var(--primary);
    margin-right: 0.3rem;
  }
  .post-cover {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    margin-bottom: 2.25rem;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }
  .tag {
    background: var(--bg-softer);
    color: var(--text-light);
    font-size: 0.85rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-pill);
    transition: background 0.18s ease, color 0.18s ease;
  }
  .tag:hover {
    background: var(--primary);
    color: #fff;
  }
  .post-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding: 1.75rem;
    background: var(--primary-50);
    border-color: var(--primary-100);
  }
  .post-cta h3 {
    font-size: 1.2rem;
  }
  .post-cta p {
    color: var(--text-light);
    font-size: 0.95rem;
    margin-top: 0.3rem;
  }
  .post-cta-actions {
    display: flex;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 2.5rem 0;
    font-weight: 600;
    color: var(--primary-dark);
  }
  @media (max-width: 560px) {
    .post-cta-actions {
      width: 100%;
    }
    .post-cta-actions .btn {
      flex: 1;
    }
  }
</style>
