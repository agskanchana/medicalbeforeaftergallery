---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import type { DocEntry } from '../utils/docs';

interface Props {
  title: string;
  description?: string;
  group?: string;
  headings?: MarkdownHeading[];
  prev?: DocEntry | null;
  next?: DocEntry | null;
}

const { title, description, group, headings = [], prev, next } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={title} description={description}>
  <div class="docs">
    <div class="container docs-grid">
      <!-- Sidebar -->
      <aside class="docs-aside">
        <details class="docs-mobile">
          <summary>Documentation menu</summary>
          <DocsSidebar />
        </details>
        <div class="docs-desktop">
          <DocsSidebar />
        </div>
      </aside>

      <!-- Content -->
      <article class="docs-content">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/docs/">Docs</a>
          {group && (<><span aria-hidden="true">/</span> <span>{group}</span></>)}
        </nav>
        <h1>{title}</h1>
        {description && <p class="docs-lead">{description}</p>}

        <div class="prose docs-prose">
          <slot />
        </div>

        <nav class="docs-prevnext" aria-label="Pagination">
          {
            prev ? (
              <a href={`/docs/${prev.id}/`} class="pn prev">
                <span class="pn-label"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Previous</span>
                <span class="pn-title">{prev.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a href={`/docs/${next.id}/`} class="pn next">
                <span class="pn-label">Next <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                <span class="pn-title">{next.data.title}</span>
              </a>
            )
          }
        </nav>
      </article>

      <!-- On this page -->
      {
        toc.length > 0 && (
          <aside class="docs-toc">
            <p class="toc-title">On this page</p>
            <ul>
              {toc.map((h) => (
                <li class:list={[`depth-${h.depth}`]}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .docs {
    padding-block: 2.5rem 4rem;
  }
  .docs-grid {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr) 200px;
    gap: 2.5rem;
    align-items: start;
  }
  .docs-aside,
  .docs-toc {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    align-self: start;
    max-height: calc(100vh - var(--header-h) - 3rem);
    overflow-y: auto;
  }
  .docs-mobile {
    display: none;
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-light);
    margin-bottom: 0.75rem;
  }
  .crumbs a {
    color: var(--primary-dark);
  }
  .docs-content h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
  }
  .docs-lead {
    font-size: 1.1rem;
    color: var(--text-light);
    margin-top: 0.75rem;
  }
  .docs-prose {
    margin-top: 2rem;
  }

  .docs-prevnext {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }
  .pn {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    max-width: 48%;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .pn:hover {
    border-color: var(--primary-light);
    transform: translateY(-2px);
  }
  .pn.next {
    text-align: right;
    margin-left: auto;
  }
  .pn-label {
    font-size: 0.78rem;
    color: var(--text-lighter);
  }
  .pn-title {
    font-weight: 600;
    color: var(--ink);
  }

  .docs-toc {
    font-size: 0.85rem;
  }
  .toc-title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-lighter);
    margin-bottom: 0.75rem;
  }
  .docs-toc ul {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border-left: 2px solid var(--border);
  }
  .docs-toc a {
    display: block;
    padding-left: 0.85rem;
    margin-left: -2px;
    border-left: 2px solid transparent;
    color: var(--text-light);
    line-height: 1.4;
  }
  .docs-toc a:hover {
    color: var(--primary-dark);
  }
  .docs-toc .depth-3 a {
    padding-left: 1.6rem;
    font-size: 0.82rem;
  }
  .docs-toc a.toc-active {
    color: var(--primary-dark);
    font-weight: 600;
    border-left-color: var(--primary);
  }

  @media (max-width: 1080px) {
    .docs-grid {
      grid-template-columns: 230px minmax(0, 1fr);
    }
    .docs-toc {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .docs-grid {
      grid-template-columns: 1fr;
    }
    .docs-aside {
      position: static;
      max-height: none;
      overflow: visible;
    }
    .docs-desktop {
      display: none;
    }
    .docs-mobile {
      display: block;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.5rem 1rem;
      background: #fff;
    }
    .docs-mobile summary {
      cursor: pointer;
      font-weight: 600;
      padding: 0.4rem 0;
    }
    .docs-mobile[open] summary {
      margin-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
    }
  }
</style>

<script>
  // Highlight the current TOC entry while scrolling
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.docs-toc a'));
  if (links.length) {
    const map = new Map<string, HTMLAnchorElement>();
    links.forEach((l) => {
      const id = decodeURIComponent(l.getAttribute('href') || '').slice(1);
      if (id) map.set(id, l);
    });
    const headings = [...map.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((l) => l.classList.remove('toc-active'));
            map.get(e.target.id)?.classList.add('toc-active');
          }
        });
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );
    headings.forEach((h) => io.observe(h));
  }
</script>
